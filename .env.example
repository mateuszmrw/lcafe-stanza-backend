# Database configuration
DB_DATABASE=db
DB_USERNAME=user
DB_PASSWORD=password

# Backend secrets (REQUIRED - change these in production!)
jwt_secret=change-me-in-production
db_encryption_key=change-me-in-production

# Optional: seed an admin user on first startup
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: DeepL translation API key
DEEPL_API_KEY=

# Frontend (baked into the Next.js client bundle at docker build time)
# Must be the URL the *browser* can reach. Default works for local dev.
NEXT_PUBLIC_API_URL=http://localhost:8678
