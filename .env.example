# Database configuration
DB_DATABASE=db
DB_USERNAME=user
DB_PASSWORD=password

# Backend secrets — REQUIRED, must be at least 32 characters each.
# Generate with: openssl rand -base64 32
JWT_SECRET=
DB_ENCRYPTION_KEY=

# Optional: DeepL translation API key
DEEPL_API_KEY=

# Frontend (baked into the Next.js client bundle at docker build time)
# Must be the URL the *browser* can reach. Default works for local dev.
NEXT_PUBLIC_API_URL=http://localhost:8678
